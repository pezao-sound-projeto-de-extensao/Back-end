meta {
  name: Refresh - apos logout (400)
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/auth/refresh
  body: json
  auth: none
}

body:json {
  {
    "refreshToken": "{{refreshToken}}"
  }
}

tests {
  test("status 400", function () {
    expect(res.getStatus()).to.equal(400);
  });

  test("mensagem de erro", function () {
    expect(res.body.detail).to.contain("revogado");
  });
}
