meta {
  name: Criar unidade - sem abreviacao (400)
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/unidades
  body: json
  auth: inherit
}

body:json {
  {
    "nome": "Sem abreviacao {{runId}}",
    "abreviacao": ""
  }
}

tests {
  test("status 400", function () {
    expect(res.getStatus()).to.equal(400);
  });

  test("valida abreviacao", function () {
    expect(res.body.errors).to.have.property("abreviacao");
  });
}
