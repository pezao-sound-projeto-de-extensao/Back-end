meta {
  name: Criar unidade descartavel
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/unidades
  body: json
  auth: inherit
}

body:json {
  {
    "nome": "Descartavel {{runId}}",
    "abreviacao": "DS"
  }
}

script:post-response {
  if (res.getStatus() === 201) {
    bru.setVar("unidadeDescartavelId", res.body.id);
  }
}

tests {
  test("status 201", function () {
    expect(res.getStatus()).to.equal(201);
  });
}
