meta {
  name: Atualizar unidade - nome de outra (409)
  type: http
  seq: 6
}

put {
  url: {{baseUrl}}/unidades/{{unidadeId}}
  body: json
  auth: inherit
}

body:json {
  {
    "nome": "Metro",
    "abreviacao": "M"
  }
}

tests {
  test("status 409", function () {
    expect(res.getStatus()).to.equal(409);
  });
}
