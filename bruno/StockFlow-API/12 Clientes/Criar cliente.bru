meta {
  name: Criar cliente
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/clientes
  body: json
  auth: inherit
}

body:json {
  {
    "nome": "Cliente {{runId}}",
    "telefone": "(11) 3333-4444"
  }
}

script:post-response {
  if (res.getStatus() === 201) {
    bru.setVar("clienteId", res.body.id);
  }
}

tests {
  test("status 201", function () {
    expect(res.getStatus()).to.equal(201);
  });
}

docs {
  Captura `clienteId`.
}
