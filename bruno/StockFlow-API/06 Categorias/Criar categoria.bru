meta {
  name: Criar categoria
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/categorias
  body: json
  auth: inherit
}

body:json {
  {
    "nome": "Categoria Teste {{runId}}"
  }
}

script:post-response {
  if (res.getStatus() === 201) {
    bru.setVar("categoriaId", res.body.id);
  }
}

tests {
  test("status 201", function () {
    expect(res.getStatus()).to.equal(201);
  });
}

docs {
  Captura `categoriaId`, usada pelos itens.
}
