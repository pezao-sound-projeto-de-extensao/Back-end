meta {
  name: Atualizar categoria
  type: http
  seq: 5
}

put {
  url: {{baseUrl}}/categorias/{{categoriaId}}
  body: json
  auth: inherit
}

body:json {
  {
    "nome": "Categoria Teste {{runId}} Editada"
  }
}

tests {
  test("status 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("altera o nome", function () {
    expect(res.body.nome).to.contain("Editada");
  });
}
