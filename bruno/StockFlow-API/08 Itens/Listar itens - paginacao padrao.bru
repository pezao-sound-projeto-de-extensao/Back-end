meta {
  name: Listar itens - paginacao padrao
  type: http
  seq: 24
}

get {
  url: {{baseUrl}}/itens
  body: none
  auth: inherit
}

tests {
  test("status 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("sem page/size: página 0 com 10 itens", function () {
    expect(res.body.number).to.equal(0);
    expect(res.body.size).to.equal(10);
    expect(res.body.content.length).to.be.at.most(10);
  });

  test("ordenado por id crescente", function () {
    const ids = res.body.content.map(i => i.id);
    expect(ids).to.deep.equal([...ids].sort((a, b) => a - b));
  });
}

docs {
  Sem parâmetros, vale o `@PageableDefault`: `page=0`, `size=10`, `sort=id,asc`.
}
