meta {
  name: Enviar imagem - acima de 50 megapixels (400)
  type: http
  seq: 25
}

post {
  url: {{baseUrl}}/itens/{{itemId}}/imagem
  body: multipartForm
  auth: inherit
}

body:multipart-form {
  arquivo: @file(fixtures/imagem-50mp.png)
}

tests {
  test("status 400", function () {
    expect(res.getStatus()).to.equal(400);
  });

  test("mensagem de erro", function () {
    expect(res.body.detail).to.contain("50 megapixels");
  });
}

docs {
  Proteção contra "bomba de descompressão": um PNG pequeno no disco que, decodificado, ocuparia
  muita memória. A API lê só as dimensões do cabeçalho e recusa acima de 50 MP antes de processar.
  `fixtures/imagem-50mp.png` tem 7100×7100 (50,4 MP) em 1 bit por pixel, por isso poucos KB.
}
