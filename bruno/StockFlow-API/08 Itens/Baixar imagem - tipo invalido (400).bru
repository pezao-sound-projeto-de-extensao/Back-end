meta {
  name: Baixar imagem - tipo invalido (400)
  type: http
  seq: 17
}

get {
  url: {{baseUrl}}/itens/{{itemId}}/imagem/download?tipo=xx
  body: none
  auth: inherit
}

params:query {
  tipo: xx
}

tests {
  test("status 400", function () {
    expect(res.getStatus()).to.equal(400);
  });

  test("informa os tipos aceitos", function () {
    expect(res.body.detail).to.contain("Use icon ou full");
  });
}
