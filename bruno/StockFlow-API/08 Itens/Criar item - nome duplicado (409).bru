meta {
  name: Criar item - nome duplicado (409)
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/itens
  body: json
  auth: inherit
}

body:json {
  {
    "nome": "caixa de som {{runId}}",
    "categoriaId": {{categoriaId}},
    "unidadeId": {{unidadeId}},
    "quantidadeAtual": 0,
    "quantidadeMinima": 0
  }
}

tests {
  test("status 409", function () {
    expect(res.getStatus()).to.equal(409);
  });

  test("responde ProblemDetail", function () {
    expect(res.body).to.have.property("detail");
  });
}
