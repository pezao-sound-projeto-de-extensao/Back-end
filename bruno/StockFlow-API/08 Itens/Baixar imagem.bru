meta {
  name: Baixar imagem
  type: http
  seq: 15
}

get {
  url: {{baseUrl}}/itens/{{itemId}}/imagem/download?tipo=full
  body: none
  auth: inherit
}

params:query {
  tipo: full
}

script:pre-request {
  await bru.sleep(3000);
}

tests {
  test("status 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("devolve a versão full em webp", function () {
    expect(res.getHeader("content-type")).to.contain("image/webp");
  });
}

docs {
  `tipo=full` (padrão) devolve a versão com lado máximo de 900px. Espera 3s antes de chamar para
  dar tempo ao consumidor do RabbitMQ processar o upload anterior.
}
