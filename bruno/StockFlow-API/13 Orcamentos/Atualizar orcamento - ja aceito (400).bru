meta {
  name: Atualizar orcamento - ja aceito (400)
  type: http
  seq: 18
}

put {
  url: {{baseUrl}}/orcamentos/{{orcamentoId}}
  body: json
  auth: inherit
}

body:json {
  {
    "clienteId": {{clienteId}},
    "itens": [ { "itemId": {{itemId}}, "quantidade": 1, "precoUnitario": 300.00 } ]
  }
}

tests {
  test("status 400", function () {
    expect(res.getStatus()).to.equal(400);
  });

  test("mensagem de erro", function () {
    expect(res.body.detail).to.contain("editar um orçamento pendente");
  });
}
