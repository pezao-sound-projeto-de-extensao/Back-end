meta {
  name: Buscar orcamento
  type: http
  seq: 13
}

get {
  url: {{baseUrl}}/orcamentos/{{orcamentoId}}
  body: none
  auth: inherit
}

tests {
  test("status 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("traz os itens com subtotal", function () {
    expect(res.body.itens).to.have.lengthOf(2);
    expect(res.body.itens[0]).to.have.property("subtotal");
  });
}
