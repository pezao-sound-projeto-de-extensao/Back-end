meta {
  name: Criar orcamento - itemId e descricao (400)
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/orcamentos
  body: json
  auth: inherit
}

body:json {
  {
    "clienteId": {{clienteId}},
    "itens": [ { "itemId": {{itemId}}, "descricao": "Duplo", "quantidade": 1, "precoUnitario": 300.00 } ]
  }
}

tests {
  test("status 400", function () {
    expect(res.getStatus()).to.equal(400);
  });

  test("mensagem de erro", function () {
    expect(res.body.detail).to.contain("não os dois");
  });
}
