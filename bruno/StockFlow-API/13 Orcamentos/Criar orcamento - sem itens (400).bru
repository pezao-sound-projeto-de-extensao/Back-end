meta {
  name: Criar orcamento - sem itens (400)
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/orcamentos
  body: json
  auth: inherit
}

body:json {
  {
    "clienteId": {{clienteId}},
    "itens": []
  }
}

tests {
  test("status 400", function () {
    expect(res.getStatus()).to.equal(400);
  });

  test("valida itens", function () {
    expect(res.body.errors).to.have.property("itens");
  });
}
