meta {
  name: Criar orcamento - item sem itemId nem descricao (400)
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/orcamentos
  body: json
  auth: inherit
}

body:json {
  {
    "clienteId": {{clienteId}},
    "itens": [ { "quantidade": 1, "precoUnitario": 300.00 } ]
  }
}

tests {
  test("status 400", function () {
    expect(res.getStatus()).to.equal(400);
  });

  test("mensagem de erro", function () {
    expect(res.body.detail).to.contain("precisa de uma descrição");
  });
}
