meta {
  name: Criar orcamento - sem cliente (400)
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/orcamentos
  body: json
  auth: inherit
}

body:json {
  {
    "itens": [ { "itemId": {{itemId}}, "quantidade": 1, "precoUnitario": 300.00 } ]
  }
}

tests {
  test("status 400", function () {
    expect(res.getStatus()).to.equal(400);
  });

  test("mensagem de erro", function () {
    expect(res.body.detail).to.contain("Informe o cliente");
  });
}
