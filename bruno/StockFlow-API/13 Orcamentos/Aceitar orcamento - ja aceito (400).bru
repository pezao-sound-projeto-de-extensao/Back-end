meta {
  name: Aceitar orcamento - ja aceito (400)
  type: http
  seq: 17
}

patch {
  url: {{baseUrl}}/orcamentos/{{orcamentoId}}/aceitar
  body: none
  auth: inherit
}

tests {
  test("status 400", function () {
    expect(res.getStatus()).to.equal(400);
  });

  test("mensagem de erro", function () {
    expect(res.body.detail).to.contain("pendente");
  });
}
