meta {
  name: Refresh - token malformado (400)
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/auth/refresh
  body: json
  auth: none
}

body:json {
  {
    "refreshToken": "sem-ponto"
  }
}

tests {
  test("status 400", function () {
    expect(res.getStatus()).to.equal(400);
  });
}

docs {
  O refresh token tem o formato `<id>.<segredo>`; sem o ponto → 400.
}
