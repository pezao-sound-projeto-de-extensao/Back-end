meta {
  name: Refresh - token reutilizado (400)
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/auth/refresh
  body: json
  auth: none
}

body:json {
  {
    "refreshToken": "{{refreshTokenAnterior}}"
  }
}

tests {
  test("status 400", function () {
    expect(res.getStatus()).to.equal(400);
  });

  test("mensagem de erro", function () {
    expect(res.body.detail).to.contain("revogado");
  });
}

docs {
  Reenvia o refresh token já consumido no passo anterior → 400 `Refresh token inválido ou revogado`.
}
