meta {
  name: Login - senha errada (401)
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "{{adminEmail}}",
    "senha": "senha_errada"
  }
}

tests {
  test("status 401", function () {
    expect(res.getStatus()).to.equal(401);
  });

  test("responde ProblemDetail", function () {
    expect(res.body).to.have.property("detail");
  });
}

docs {
  Senha incorreta → `BadCredentialsException` → 401.
}
