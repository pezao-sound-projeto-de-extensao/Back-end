meta {
  name: Orcamento concluido
  type: http
  seq: 14
}

get {
  url: {{baseUrl}}/orcamentos/{{orcamentoId}}
  body: none
  auth: inherit
}

tests {
  test("status 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("todas as encomendas concluídas → CONCLUIDO", function () {
    expect(res.body.status).to.equal("CONCLUIDO");
  });
}
