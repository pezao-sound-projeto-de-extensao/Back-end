meta {
  name: Receber produto novo - sem itemId (400)
  type: http
  seq: 15
}

patch {
  url: {{baseUrl}}/encomendas/{{encomendaProdutoNovoId}}/receber
  body: json
  auth: inherit
}

body:json {
  {}
}

tests {
  test("status 400", function () {
    expect(res.getStatus()).to.equal(400);
  });

  test("mensagem de erro", function () {
    expect(res.body.detail).to.contain("informe o itemId");
  });
}

docs {
  Encomenda de produto que não estava cadastrado exige o `itemId` do produto correspondente.
}
