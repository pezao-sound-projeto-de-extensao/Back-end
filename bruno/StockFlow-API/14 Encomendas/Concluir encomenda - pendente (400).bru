meta {
  name: Concluir encomenda - pendente (400)
  type: http
  seq: 6
}

patch {
  url: {{baseUrl}}/encomendas/{{encomendaId}}/concluir
  body: none
  auth: inherit
}

tests {
  test("status 400", function () {
    expect(res.getStatus()).to.equal(400);
  });

  test("mensagem de erro", function () {
    expect(res.body.detail).to.contain("recebida");
  });
}

docs {
  Só encomenda RECEBIDA pode ser concluída.
}
