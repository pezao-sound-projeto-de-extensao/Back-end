meta {
  name: Buscar encomenda
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/encomendas/{{encomendaId}}
  body: none
  auth: inherit
}

tests {
  test("status 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("PENDENTE com 2 unidades", function () {
    expect(res.body.status).to.equal("PENDENTE");
    expect(res.body.quantidade).to.equal(2);
  });
}
