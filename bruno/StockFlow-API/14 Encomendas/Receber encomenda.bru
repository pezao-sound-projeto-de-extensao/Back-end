patch {
  url: {{baseUrl}}/encomendas/{{encomendaId}}/receber
  body: json
  auth: inherit
}

body:json {
  {}
}

tests {
  test("status 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("RECEBIDA com data de recebimento", function () {
    expect(res.body.status).to.equal("RECEBIDA");
    expect(res.body.recebidaEm).to.not.equal(null);
  });
}

docs {
  Corpo `{}`: a encomenda já aponta para um produto do catálogo. Registra entrada de 2 no estoque.

  **Atenção:** o `@RequestBody(required = false)` ainda exige `Content-Type: application/json`; sem corpo o Bruno manda `application/x-www-form-urlencoded` e a API responde 415.
}
