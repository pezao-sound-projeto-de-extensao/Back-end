meta {
  name: Criar usuario - com senha
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/usuarios
  body: json
  auth: inherit
}

body:json {
  {
    "nome": "Usuario Teste {{runId}}",
    "email": "{{usuarioEmail}}",
    "cargo_id": {{cargoId}},
    "senha": "{{usuarioSenhaInicial}}"
  }
}

script:pre-request {
  bru.setVar("usuarioEmail", "teste." + bru.getVar("runId") + "@example.com");
  bru.setVar("usuarioSenhaInicial", "Inicial" + bru.getVar("runId"));
}

script:post-response {
  if (res.getStatus() === 201) {
    bru.setVar("usuarioId", res.body.id);
  }
}

tests {
  test("status 201", function () {
    expect(res.getStatus()).to.equal(201);
  });

  test("com senha informada, não envia convite", function () {
    expect(res.body.conviteEnviado).to.equal(false);
    expect(res.body).to.not.have.property("senhaPadraoTemporaria");
  });
}

docs {
  Captura `usuarioId`, `usuarioEmail` e `usuarioSenhaInicial` (definida aqui, 8 a 20 caracteres).
  O campo do cargo é `cargo_id` (com underline). E-mail em `example.com` (reservado para testes):
  o reset da pasta 05 envia e-mail de verdade.
}
