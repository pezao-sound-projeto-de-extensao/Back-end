meta {
  name: Login - usuario inativo (401)
  type: http
  seq: 11
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "{{usuarioEmail}}",
    "senha": "{{usuarioSenhaTemp}}"
  }
}

tests {
  test("status 401", function () {
    expect(res.getStatus()).to.equal(401);
  });
}

docs {
  Usuário inativo não autentica, mesmo com a senha correta.
}
