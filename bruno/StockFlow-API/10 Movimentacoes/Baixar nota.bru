meta {
  name: Baixar nota
  type: http
  seq: 13
}

get {
  url: {{baseUrl}}/movimentacoes/{{movimentacaoId}}/nota/download
  body: none
  auth: inherit
}

tests {
  test("status 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("devolve o PDF", function () {
    expect(res.getHeader("content-type")).to.contain("application/pdf");
  });
}
