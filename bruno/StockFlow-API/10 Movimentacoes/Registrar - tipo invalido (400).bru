meta {
  name: Registrar - tipo invalido (400)
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/movimentacoes
  body: json
  auth: inherit
}

body:json {
  {
    "itemId": {{itemSemImagemId}},
    "tipo": "transferencia",
    "quantidade": 1
  }
}

tests {
  test("status 400", function () {
    expect(res.getStatus()).to.equal(400);
  });

  test("valida tipo", function () {
    expect(res.body.errors).to.have.property("tipo");
  });
}
