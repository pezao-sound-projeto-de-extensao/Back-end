meta {
  name: Registrar - quantidade zero (400)
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/movimentacoes
  body: json
  auth: inherit
}

body:json {
  {
    "itemId": {{itemSemImagemId}},
    "tipo": "entrada",
    "quantidade": 0
  }
}

tests {
  test("status 400", function () {
    expect(res.getStatus()).to.equal(400);
  });

  test("valida quantidade", function () {
    expect(res.body.errors).to.have.property("quantidade");
  });
}
