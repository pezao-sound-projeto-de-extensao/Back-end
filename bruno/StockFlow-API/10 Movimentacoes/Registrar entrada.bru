meta {
  name: Registrar entrada
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/movimentacoes
  body: json
  auth: inherit
}

body:json {
  {
    "itemId": {{itemSemImagemId}},
    "tipo": "entrada",
    "quantidade": 5,
    "data": "{{hoje}}",
    "observacao": "Reposição de estoque"
  }
}

script:post-response {
  if (res.getStatus() === 201) {
    bru.setVar("movimentacaoId", res.body.id);
  }
}

tests {
  test("status 201", function () {
    expect(res.getStatus()).to.equal(201);
  });

  test("5 → 10", function () {
    expect(res.body.tipo).to.equal("entrada");
    expect(res.body.estoqueAntes).to.equal(5);
    expect(res.body.estoqueDepois).to.equal(10);
    expect(res.body.item.id).to.equal(Number(bru.getVar("itemSemImagemId")));
  });
}

docs {
  Captura `movimentacaoId`.
}
