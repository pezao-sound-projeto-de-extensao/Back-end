meta {
  name: Criar cargo - permissao inexistente (400)
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/cargos
  body: json
  auth: inherit
}

body:json {
  {
    "nome": "Cargo Invalido {{runId}}",
    "descricao": "Permissão que não existe",
    "permissoes": ["PERMISSAO_INEXISTENTE"]
  }
}

tests {
  test("status 400", function () {
    expect(res.getStatus()).to.equal(400);
  });

  test("mensagem de erro", function () {
    expect(res.body.detail).to.contain("permissões informadas não existe");
  });
}
