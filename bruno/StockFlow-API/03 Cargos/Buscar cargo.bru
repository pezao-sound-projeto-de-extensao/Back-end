meta {
  name: Buscar cargo
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/cargos/{{cargoId}}
  body: none
  auth: inherit
}

tests {
  test("status 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("devolve o cargo pedido", function () {
    expect(res.body.id).to.equal(Number(bru.getVar("cargoId")));
  });
}
