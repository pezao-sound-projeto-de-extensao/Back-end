meta {
  name: Resetar senha
  type: http
  seq: 10
}

put {
  url: {{baseUrl}}/auth/resetar-senha/{{usuarioId}}
  body: none
  auth: inherit
}

tests {
  test("status 204", function () {
    expect(res.getStatus()).to.equal(204);
  });
}

docs {
  Exige `GERENCIAR_USUARIOS`. Invalida a senha do usuário (troca por uma aleatória), revoga os
  refresh tokens dele e envia por e-mail o link para criar uma nova (válido por 24 h).
}
